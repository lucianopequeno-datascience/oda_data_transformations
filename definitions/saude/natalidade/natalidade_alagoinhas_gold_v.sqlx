config {
  type: "table",
  schema: "dados_alagoinhas_gold",
  name: "natalidade_alagoinhas_gold_v",
  description: "Dados de natalidade de Alagoinhas com aliases compatíveis com o relatório existente"
}

SELECT

  CAST(CODESTAB AS STRING) AS codigo_estabelecimento,
  SAFE.PARSE_DATE('%d%m%Y', CAST(DTNASC AS STRING)) AS data_nascimento,
  CODANOMAL AS codigo_anomalia,

--- tratamento escolaridade da mãe

  CASE SAFE_CAST(ESCMAE2010 AS INT64)
    WHEN 1 THEN "Nenhuma"
    WHEN 2 THEN "1 a 3 anos"
    WHEN 3 THEN "4 a 7 anos"
    WHEN 4 THEN "8 a 11 anos"
    WHEN 5 THEN "12 anos ou mais"
    WHEN 9 THEN "Ignorado"
    ELSE "Não informado"
  END AS desc_escolaridade_mae,

--- tratamento situação conjulgal da mãe

  CASE SAFE_CAST(ESTCIVMAE AS INT64)
    WHEN 1 THEN "Solteira"
    WHEN 2 THEN "Casada"
    WHEN 3 THEN "Viúva"
    WHEN 4 THEN "Separada judicialmente"
    WHEN 5 THEN "União consensual"
    WHEN 9 THEN "Ignorado"
    ELSE "Não informado"
  END AS estado_civil_mae,

--- tratamento id da anomalia

  CASE SAFE_CAST(IDANOMAL AS INT64)
    WHEN 1 THEN "Sim"
    WHEN 2 THEN "Não"
    WHEN 9 THEN "Ignorado"
    ELSE "Não informado"
  END AS id_anomalia,

  SAFE_CAST(IDADEMAE AS INT64) AS idade_mae,
  SAFE_CAST(IDADEPAI AS INT64) AS idade_pai,
  SAFE_CAST(PESO AS INT64) AS peso,

  CASE SAFE_CAST(RACACOR AS INT64)
    WHEN 1 THEN "Branca"
    WHEN 2 THEN "Preta"
    WHEN 3 THEN "Amarela"
    WHEN 4 THEN "Parda"
    WHEN 5 THEN "Indígena"
    WHEN 9 THEN "Ignorado"
    ELSE "Não informado"
  END AS raca_cor,

  CAST(contador AS STRING) AS sequencial_nascimento,

  CASE
    WHEN UPPER(TRIM(SEXO)) IN ("1", "M") THEN "Masculino"
    WHEN UPPER(TRIM(SEXO)) IN ("2", "F") THEN "Feminino"
    WHEN UPPER(TRIM(SEXO)) IN ("0", "9", "I") THEN "Ignorado"
    ELSE "Não informado"
  END AS sexo,

  CASE SAFE_CAST(GRAVIDEZ AS INT64)
    WHEN 1 THEN "Única"
    WHEN 2 THEN "Dupla"
    WHEN 3 THEN "Tripla ou mais"
    WHEN 9 THEN "Ignorado"
    ELSE "Não informado"
  END AS tipo_gravidez

FROM ${ref("natalidade_alagoinhas_silver")}