config {
  type: "view",
  schema: "dados_alagoinhas_gold",
  name: "anomalia_natalidade_gold_v",
  description: "Dados de natalidade com anomalias congênitas enriquecidos com CID-10"
}

SELECT
  n.*,
  c.*
FROM
  ${ref("natalidade_alagoinhas_gold_v")} AS n
LEFT JOIN
  ${ref("cid10")} AS c
ON
  TRIM(CAST(n.codigo_anomalia AS STRING)) =
  TRIM(CAST(c.subcategoria AS STRING))
WHERE
  n.codigo_anomalia IS NOT NULL