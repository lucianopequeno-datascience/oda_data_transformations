config {
  type: "view",
  schema: "dados_alagoinhas_gold",
  name: "contador",
  description: "Contagem de notificações de acidentes de trabalho por data"
}

SELECT
  DT_NOTIFIC AS data_notificacao,
  COUNT(DT_NOTIFIC) AS total_notificacoes
FROM
  ${ref("acidentes_de_trabalho_silver")}
GROUP BY
  1